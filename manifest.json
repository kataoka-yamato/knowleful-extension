{
  "manifest_version": 3,
  "name": "Knowleful コード生成支援ツール",
  "version": "1.0.0",
  "description": "機密情報をマスキングしてAIコード生成を支援するツール",
  "permissions": [
    "activeTab",
    "downloads",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://kataoka-yamato.github.io/knowleful-extension/version.json"
  ],
  "content_scripts": [
    {
      "matches": ["https://chat.knowleful.jp/*"],
      "js": [
        "src/storage.js",
        "src/formatter.js",
        "src/masker.js",
        "src/parser.js",
        "src/prompt.js",
        "src/ui.js",
        "src/update-notifier.js",
        "content.js"
      ],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none';"
  }
}